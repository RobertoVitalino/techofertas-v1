# Vitalino Tech
NEXT_PUBLIC_SITE_NAME="TechOfertas"
# Usado no sitemap, robots.txt e nas tags Open Graph. Na Vercel, defina como
# o domínio real do site (ex: "https://www.techofertas.com.br").
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Use a conexão fornecida pelo seu provedor (Neon, Prisma Postgres etc.).
DATABASE_URL="postgresql://usuario:senha@host:5432/techofertas?sslmode=require"

# Acesso ao painel administrativo. Nunca envie os valores reais ao GitHub.
ADMIN_EMAIL="seu-email@exemplo.com"
ADMIN_PASSWORD="crie-uma-senha-forte"
AUTH_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
# Opcional: ative o segundo fator com `npm run mfa:setup` e cadastre a chave no Vercel.
ADMIN_TOTP_SECRET=""

# Certificado pago do curso de Segurança da Informação (Mercado Pago Checkout Pro).
# Access Token da sua conta Mercado Pago (Suas integrações > credenciais de produção/teste).
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta configurada na sua integração para validar a assinatura do webhook.
MERCADOPAGO_WEBHOOK_SECRET=""
# Preço do certificado em centavos (2990 = R$ 29,90). Pode alterar sem redeploy de código.
CERTIFICATE_PRICE_CENTS="2990"

# Alertas de ofertas por e-mail (Resend - resend.com).
# Crie uma conta gratuita, verifique seu domínio de envio e gere uma API key.
RESEND_API_KEY=""
# Remetente usado nos e-mails de alerta. Precisa ser de um domínio verificado no Resend.
DEAL_ALERT_FROM_EMAIL="Vitalino Tech <ofertas@vitalinotech.com.br>"

# Rastreamento de conversão para tráfego pago (opcional). Deixe em branco para
# não carregar nenhum script — o site funciona normalmente sem eles.
# GA4: Admin > Fluxos de dados > seu fluxo da Web > ID de MEDIÇÃO (formato G-XXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Meta Pixel: Gerenciador de Eventos > sua fonte de dados > ID do Pixel.
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Ads: Ferramentas > Conversões > seu ID de conversão (formato AW-XXXXXXXXX).
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Rótulos de conversão específicos de cada ação (Google Ads > Conversões > editar
# a conversão > Detalhes da tag > "send_to", a parte depois da barra).
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""
